{
    "version": "0.14.0",
    "description": "MinerU - A document parsing engine that converts PDFs, Office files, images, and web pages into structured Markdown or JSON",
    "homepage": "https://mineru.net",
    "license": "Proprietary",
    "url": "https://webpub.shlab.tech/MinerU/latest/win/MinerU-0.14.0-setup.exe#/dl.7z",
    "hash": "340e3fe1ded7b00da6700e6025497290aeecc3a120b352caacc554ad375a979d",
    "architecture": {
        "64bit": {
            "pre_install": "Expand-7zipArchive -Path \"$dir\\`$PLUGINSDIR\\app-64.7z\" -DestinationPath \"$dir\" -Removal"
        },
        "32bit": {
            "pre_install": "Expand-7zipArchive -Path \"$dir\\`$PLUGINSDIR\\app-32.7z\" -DestinationPath \"$dir\" -Removal"
        }
    },
    "post_install": [
        "Remove-Item -Path \"$dir\\`$*\" -Recurse -Force -ErrorAction SilentlyContinue",
        "Remove-Item -Path \"$dir\\resources\\app-update.yml\" -Force -ErrorAction SilentlyContinue"
    ],
    "shortcuts": [
        [
            "MinerU.exe",
            "MinerU",
            "--user-data-dir=\"User Data\""
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "url": "https://webpub.shlab.tech/MinerU/latest/win/latest.yml?a=1",
        "regex": "version: ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://webpub.shlab.tech/MinerU/latest/win/MinerU-$version-setup.exe#/dl.7z"
    }
}
