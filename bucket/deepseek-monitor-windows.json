    "license": "MIT",
    "notes": [
        "Microsoft Edge WebView2 Runtime is required. Windows 11 usually includes it; Windows 10 may require a separate install.",
        "The app stores API keys and usage tokens at %APPDATA%\\DeepSeekMonitorWindows\\config.json.",
        "WebView2 login cache is stored at %LOCALAPPDATA%\\com.deepseek.monitor.windows\\EBWebView and is not managed by Scoop persist."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/Joyi-code/DeepSeekMonitorWindows/releases/download/v1.2.3/DeepSeekMonitorWindows_1.2.3_x64-setup.exe#/dl.7z",
            "hash": "3148178abb80aa5db02136cb1298c12e7f36eeef43d94a14bb826a525c26fc99",
            "pre_install": "Remove-Item \"$dir\\`$PLUGINSDIR\" -Force -Recurse"
        }
    },
    "bin": [
        [
            "app.exe",
            "deepseek-monitor-windows"
        ]
    ],
    "shortcuts": [
        [
            "app.exe",
            "DeepSeek Monitor Windows"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Joyi-code/DeepSeekMonitorWindows/releases/download/v$version/DeepSeekMonitorWindows_$version_x64-setup.exe#/dl.7z"
            }
        },
        "hash": {
            "url": "https://github.com/Joyi-code/DeepSeekMonitorWindows/releases/tag/v$version",
            "regex": "SHA256:\\s*([a-fA-F0-9]{64})"
        }
    }
}
